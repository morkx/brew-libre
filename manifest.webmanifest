{
  "name": "Brew-libre",
  "short_name": "Brew-libre",
  "description": "Recetario cervecero libre: diseño de recetas, agua, macerado, fermentación y carbonatación. Métrico, sin cuenta, funciona sin conexión.",
  "lang": "es",
  "start_url": "./",
  "scope": "./",
  "id": "./",
  "display": "standalone",
  "background_color": "#eaeeec",
  "theme_color": "#a8541f",
  "categories": ["food", "utilities", "productivity"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/json": [".json"],
        "text/xml": [".xml", ".beerxml"]
      }
    }
  ]
}
